=\"text-align:left\">Artigo</th><th style=\"text-align:center;width:12ch\">Total</th></tr></thead><tbody>{% for linha in lines %}<tr><td style=\"text-align:left\">{{ linha.designation }}</td><td style=\"text-align:center\">{{ linha.total }}</td></tr>{% endfor %}</tbody></table></div><img class=\"block block--code\" data-tpl-type=\"code-slot\" data-tpl-code-source=\"dynamic\" id=\"tpl-qr\" alt=\"\" data-tpl-node=\"document\" data-tpl-legal=\"1\" data-tpl-binding=\"document.qr\" alt=\"\"><img data-tpl-type=\"image\" src=\"data:image/png;base64,iVBORw0KGgo=\" id=\"i4pd7\" data-tpl-fit=\"contain\" class=\"block block--image\"><img data-tpl-type=\"image\" src=\"data:image/png;base64,iVBORw0KGgo=\" style=\"width:25mm; height:12.5mm\" id=\"tpl-logo\"></div></div></body>",
