tical-align:middle}";}s:4:"roll";a:2:{s:5:"pages";a:1:{i:0;a:2:{s:8:"template";s:5162:"<div class="page"><div class="zone zone--header"><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="documento.designacao" data-tpl-format="" data-tpl-legal="1" id="tpl-designacao">{{ documento.designacao }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="documento.numero" data-tpl-format="" data-tpl-legal="1" id="tpl-numero">{{ documento.numero }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="documento.atcud" data-tpl-format="" data-tpl-legal="1" id="tpl-atcud">{{ documento.atcud }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="documento.data_emissao" data-tpl-format="date" data-tpl-legal="1" id="tpl-data-emissao">{{ documento.data_emissao|date }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="documento.data_bens" data-tpl-format="date" data-tpl-legal="0" id="tpl-data-bens">{{ documento.data_bens|date }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="emitente.nome" data-tpl-format="" data-tpl-legal="1" id="tpl-emitente-nome">{{ emitente.nome }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="emitente.nif" data-tpl-format="" data-tpl-legal="1" id="tpl-emitente-nif">{{ emitente.nif }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="emitente.morada" data-tpl-format="" data-tpl-legal="1" id="tpl-emitente-morada">{{ emitente.morada }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="adquirente.nome" data-tpl-format="" data-tpl-legal="1" id="tpl-adquirente-nome">{{ adquirente.nome }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="adquirente.nif" data-tpl-format="" data-tpl-legal="1" id="tpl-adquirente-nif">{{ adquirente.nif }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="adquirente.morada" data-tpl-format="" data-tpl-legal="1" id="tpl-adquirente-morada">{{ adquirente.morada }}</div></div><div class="zone zone--body"><div class="block block--lines" data-tpl-type="line-table" data-tpl-collection="linhas" data-tpl-columns='[{"key":"codigo","label":"Código","width":"24mm","align":"left","format":""},{"key":"descricao","label":"Descrição","width":"62mm","align":"left","format":""},{"key":"quantidade","label":"Quantidade","width":"20mm","align":"right","format":"number"},{"key":"unidade","label":"Unidade","width":"12mm","align":"left","format":""},{"key":"preco_unitario","label":"Preço unitário","width":"22mm","align":"right","format":"money"},{"key":"taxa_iva","label":"Taxa de IVA","width":"14mm","align":"right","format":""},{"key":"valor","label":"Valor","width":"26mm","align":"right","format":"money"}]' id="tpl-linhas" style="top:0mm"><table class="lines"><thead><tr><th style="text-align:left" width="24mm">Código</th><th style="text-align:left" width="62mm">Descrição</th><th style="text-align:right" width="20mm">Quantidade</th><th style="text-align:left" width="12mm">Unidade</th><th style="text-align:right" width="22mm">Preço unitário</th><th style="text-align:right" width="14mm">Taxa de IVA</th><th style="text-align:right" width="26mm">Valor</th></tr></thead><tbody>{% for linha in linhas %}<tr><td style="text-align:left">{{ linha.codigo }}</td><td style="text-align:left">{{ linha.descricao }}</td><td style="text-align:right">{{ linha.quantidade|number }}</td><td style="text-align:left">{{ linha.unidade }}</td><td style="text-align:right">{{ linha.preco_unitario|money }}</td><td style="text-align:right">{{ linha.taxa_iva }}</td><td style="text-align:right">{{ linha.valor|money }}</td></tr>{% endfor %}</tbody></table></div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="totais.motivo_isencao" data-tpl-format="" data-tpl-legal="0" id="tpl-motivo-isencao">{