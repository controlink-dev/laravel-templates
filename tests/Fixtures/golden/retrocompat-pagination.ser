tpl-binding="emitente.nif" data-tpl-format="" data-tpl-legal="1" id="tpl-emitente-nif">{{ emitente.nif }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="emitente.morada" data-tpl-format="" data-tpl-legal="1" id="tpl-emitente-morada">{{ emitente.morada }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="adquirente.nome" data-tpl-format="" data-tpl-legal="1" id="tpl-adquirente-nome">{{ adquirente.nome }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="adquirente.nif" data-tpl-format="" data-tpl-legal="1" id="tpl-adquirente-nif">{{ adquirente.nif }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="adquirente.morada" data-tpl-format="" data-tpl-legal="1" id="tpl-adquirente-morada">{{ adquirente.morada }}</div></div><div class="zone zone--body"><div class="block block--lines" data-tpl-type="line-table" data-tpl-collection="linhas" data-tpl-columns='[{"key":"codigo","label":"Código","width":"24mm","align":"left","format":""},{"key":"descricao","label":"Descrição","width":"62mm","align":"left","format":""},{"key":"quantidade","label":"Quantidade","width":"20mm","align":"right","format":"number"},{"key":"unidade","label":"Unidade","width":"12mm","align":"left","format":""},{"key":"preco_unitario","label":"Preço unitário","width":"22mm","align":"right","format":"money"},{"key":"taxa_iva","label":"Taxa de IVA","width":"14mm","align":"right","format":""},{"key":"valor","label":"Valor","width":"26mm","align":"right","format":"money"}]' id="tpl-linhas" style="top:20mm"><table class="lines"><thead><tr><th style="text-align:left" width="24mm">Código</th><th style="text-align:left" width="62mm">Descrição</th><th style="text-align:right" width="20mm">Quantidade</th><th style="text-align:left" width="12mm">Unidade</th><th style="text-align:right" width="22mm">Preço unitário</th><th style="text-align:right" width="14mm">Taxa de IVA</th><th style="text-