unidade","label":"Unidade","width":"12mm","align":"left","format":""},{"key":"preco_unitario","label":"Preço unitário","width":"22mm","align":"right","format":"money"},{"key":"taxa_iva","label":"Taxa de IVA","width":"14mm","align":"right","format":""},{"key":"valor","label":"Valor","width":"26mm","align":"right","format":"money"}]' id="tpl-linhas" style="top:0mm"><table class="lines"><thead><tr><th style="text-align:left" width="24mm">Código</th><th style="text-align:left" width="62mm">Descrição</th><th style="text-align:right" width="20mm">Quantidade</th><th style="text-align:left" width="12mm">Unidade</th><th style="text-align:right" width="22mm">Preço unitário</th><th style="text-align:right" width="14mm">Taxa de IVA</th><th style="text-align:right" width="26mm">Valor</th></tr></thead><tbody>{% for linha in linhas %}<tr><td style="text-align:left">{{ linha.codigo }}</td><td style="text-align:left">{{ linha.descricao }}</td><td style="text-align:right">{{ linha.quantidade|number }}</td><td style="text-align:left">{{ linha.unidade }}</td><td style="text-align:right">{{ linha.preco_unitario|money }}</td><td style="text-align:right">{{ linha.taxa_iva }}</td><td style="text-align:right">{{ linha.valor|money }}</td></tr>{% endfor %}</tbody></table></div></div><div class="zone zone--footer"><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="documento.certificado" data-tpl-format="" data-tpl-legal="1" id="tpl-certificado">{{ documento.certificado }}</div><div class="block block--field" data-tpl-type="data-field" data-tpl-binding="documento.hash_caracteres" data-tpl-format="" data-tpl-legal="1" id="tpl-hash">{{ documento.hash_caracteres }}</div><img class="block block--code" data-tpl-type="code-slot" data-tpl-binding="documento.qr" data-tpl-legal="1" id="tpl-qr" style="width:30mm;height:30mm" alt=""></div></div>";s:7:"dataset";a:21:{s:13:"emitente.nome";s:70:"Sociedade Industrial de Transformação e Comércio de Materiais, S.A.";s:12:"emitente.nif"