d\">{{ documento.data_emissao|date }}</div></div><div data-tpl-zone=\"body\" class=\"zone zone--body\"><div data-tpl-type=\"data-field\" data-tpl-binding=\"totais.total_impostos\" data-tpl-format=\"money\" data-tpl-legal=\"1\" id=\"pf-total-impostos\" class=\"block block--field\">{{ totais.total_impostos|money }}</div><div data-tpl-type=\"data-field\" data-tpl-binding=\"totais.total_a_pagar\" data-tpl-format=\"money\" data-tpl-legal=\"1\" id=\"pf-total-a-pagar\" class=\"block block--field\">{{ totais.total_a_pagar|money }}</div><div data-tpl-type=\"line-table\" data-tpl-collection=\"linhas\" id=\"i3r8z\" data-tpl-columns=\"[{&quot;key&quot;:&quot;codigo&quot;,&quot;label&quot;:&quot;Código&quot;,&quot;width&quot;:&quot;&quot;,&quot;align&quot;:&quot;left&quot;,&quot;format&quot;:&quot;&quot;},{&quot;key&quot;:&quot;descricao&quot;,&quot;label&quot;:&quot;Descrição&quot;,&quot;width&quot;:&quot;&quot;,&quot;align&quot;:&quot;left&quot;,&quot;format&quot;:&quot;&quot;},{&quot;key&quot;:&quot;quantidade&quot;,&quot;label&quot;:&quot;Quantidade&quot;,&quot;width&quot;:&quot;&quot;,&quot;align&quot;:&quot;right&quot;,&quot;format&quot;:&quot;number&quot;},{&quot;key&quot;:&quot;unidade&quot;,&quot;label&quot;:&quot;Unidade&quot;,&quot;width&quot;:&quot;&quot;,&quot;align&quot;:&quot;left&quot;,&quot;format&quot;:&quot;&quot;},{&quot;key&quot;:&quot;preco_unitario&quot;,&quot;label&quot;:&quot;Preço unitário&quot;,&quot;width&quot;:&quot;&quot;,&quot;align&quot;:&quot;right&quot;,&quot;format&quot;:&quot;money&quot;},{&quot;key&quot;:&quot;taxa_iva&quot;,&quot;label&quot;:&quot;Taxa de IVA&quot;,&quot;width&quot;:&quot;&quot;,&quot;align&quot;:&quot;left&quot;,&quot;format&quot;:&quot;&quot;},{&quot;key&quot;:&quot;valor&quot;,&quot;label&quot;:&quot;Valor&quot;,&quot;width&quot;:&quot;&quot;,&quot;align&quot;:&quot;right&quot;,&quot;format&quot;:&quot;money&quot;}]\" class=\"block block--lines\"><table class=\"lines\"><thead><tr><th style=\"text-align:left\">Código</th><th style=\"text-align:left\">Descrição</th><th style=\"text-align:right\">Quantidade</th><th style=\"text-align:left\">Unidade</th><th style=\"text-align:right\">Preço unitário</th><th style=\"text-align:left\">Taxa de IVA</th><th style=\"text-align:right\">Valor</th></tr></thead><tbody>{% for linha in linhas %}<tr><td style=\"text-align:left\">{{ linha.codigo }}</td><td style=\"text-align:left\">{{ linha.descricao }}</td><td style=\"text-align:right\">{{ linha.quantidade|number }}</td><td style=\"text-align:left\">{{ linha.unidade }}</td><td style=\"text-align:right\">{{ linha.preco_unitario|money }}</td><td style=\"text-align:left\">{{ linha.taxa_iva }}</td><td style=\"text-align:right\">{{ linha.valor|money }}</td></tr>{% endfor %}</tbody></table></div></div><div data-tpl-zone=\"footer\" class=\"zone zone--footer\"><div data-tpl-type=\"data-field\" data-tpl-binding=\"documento.certificado\" data-tpl-format=\"\" data-tpl-legal=\"1\" id=\"pf-certificado\" class=\"block block--field\">{{ documento.certificado }}</div><div data-tpl-type=\"data-field\" data-tpl-binding=\"documento.hash_caracteres\" data-tpl-format=\"\" data-tpl-legal=\"1\" id=\"pf-hash\" class=\"block block--field\">{{ documento.hash_caracteres }}</div><img class=\"block block--code\" data-tpl-type=\"code-slot\" data-tpl-binding=\"documento.qr\" id=\"i74a1p\" data-tpl-legal=\"1\" alt=\"\"><div data-tpl-type=\"page-number\" data-tpl-format=\"x-of-y\" class=\"block block--page-number\" id=\"ioaoa5\">{{ pagina.numero }}  {{ pagina.total }}</div></div></div></body>",
