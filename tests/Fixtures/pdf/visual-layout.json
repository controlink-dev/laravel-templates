            "css": "#pf-designacao{position:absolute;left:0;top:0;font-size:16pt;font-weight:700;color:#000}#pf-numero{position:absolute;left:0;top:8mm;font-size:10pt;color:#000}#pf-atcud{position:absolute;left:0;top:13mm;font-size:8pt;color:#000}#pf-emitente-nome{position:absolute;left:90mm;top:0;font-size:10pt;font-weight:700;color:#000}#pf-emitente-nif{position:absolute;left:90mm;top:5mm;font-size:8pt;color:#000}#pf-emitente-morada{position:absolute;left:90mm;top:9mm;font-size:8pt;color:#000}#pf-adquirente-nome{position:absolute;left:0;top:22mm;font-size:9pt;font-weight:700;color:#000}#pf-adquirente-nif{position:absolute;left:0;top:26mm;font-size:8pt;color:#000}#pf-adquirente-morada{position:absolute;left:0;top:30mm;font-size:8pt;color:#000}#pf-data-emissao{position:absolute;left:150mm;top:22mm;font-size:9pt;color:#000}#pf-total-impostos{position:absolute;right:0;bottom:12mm;font-size:9pt;color:#000}#pf-total-a-pagar{position:absolute;right:0;bottom:4mm;font-size:11pt;font-weight:700;color:#000}#pf-certificado{position:absolute;left:0;bottom:0;font-size:7pt;color:#000}#pf-hash{position:absolute;left:0;bottom:5mm;font-size:7pt;color:#000}",
