<?php

namespace {{ namespace }}\Models;

use Controlink\Templates\Templates;
use Controlink\Templates\Types\TemplateType;
use Controlink\Templates\Versions\VersionState;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\HasMany;

/**
 * A layout bound to one document type. It groups versions and holds no layout itself.
 *
 * Generated by `php artisan templates:install`. This is your code now: add tenancy,
 * soft deletes, extra columns or relations as your app needs. The package only reads
 * the shape documented in the package's docs/INTEGRATION.md off it.
 */
class Template extends Model
{
    protected $fillable = ['type_code', 'name'];

    /** The document type definition for this template's `type_code`. */
    public function type(): TemplateType
    {
        return Templates::type($this->type_code);
    }

    /** Oldest first: a version list is a history, and a history reads forwards. */
    public function versions(): HasMany
    {
        return $this->hasMany(TemplateVersion::class)->orderBy('number');
    }

    /** The version currently in production, or null when none has been activated. */
    public function activeVersion(): ?TemplateVersion
    {
        return $this->versions()->where('state', VersionState::Active)->first();
    }

    /** The next version number for this template. */
    public function nextVersionNumber(): int
    {
        return (int) $this->versions()->max('number') + 1;
    }
}
