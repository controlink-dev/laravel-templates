<?php

namespace {{ namespace }}\Http\Controllers;

use {{ namespace }}\Models\Template;
use {{ namespace }}\Models\TemplateVersion;
use Controlink\Templates\Output\Pdf\DocumentComposer;
use Controlink\Templates\Templates;
use Controlink\Templates\Toolkit\Documents;
use Controlink\Templates\Versions\VersionState;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Routing\Controller;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\File;
use Illuminate\Support\Facades\Gate;
use Symfony\Component\HttpFoundation\Response as HttpResponse;

/**
 * Reference implementation of the seven endpoints the embedded template editor talks to
 * (see the package's docs/INTEGRATION.md). The package ships no routes or controllers of
 * its own; this is generated by `php artisan templates:install` and is yours to change.
 *
 * It extends Illuminate\Routing\Controller (not your app's base Controller) so it works
 * the same on Laravel 10 through 13, where the base controller no longer has the
 * authorization trait — authorization goes through Gate::authorize() here.
 */
class TemplateEditorController extends Controller
{
    public function __construct(private readonly Documents $documents)
    {
    }

    /** GET — the version's canvas model, under `data`. */
    public function load(Template $template, TemplateVersion $version): JsonResponse
    {
        Gate::authorize('view', $template);

        return response()->json(['data' => [
            'project_data' => $version->project_data ?? [],
            'html'         => (string) $version->html,
            'css'          => (string) $version->css,
        ]]);
    }

    /**
     * PUT — save the layout after layer-1 (static) validation passes.
     *
     * Nothing is written when validation fails: a stored version always means a layout
     * that passed the static rules. An immutable version is refused with 409 rather than
     * 422 — nothing the user could retype makes it editable; the answer is a new draft.
     */
    public function save(Request $request, Template $template, TemplateVersion $version): JsonResponse
    {
        Gate::authorize('update', $template);
        abort_unless($version->isEditable(), HttpResponse::HTTP_CONFLICT);

        $type     = $template->type();
        $geometry = $this->geometry($type, $request->input('geometry'));
        $layout   = [
            'project_data' => (array) $request->input('project_data'),
            'html'         => (string) $request->input('html'),
            'css'          => (string) $request->input('css'),
        ];

        $problems = $this->documents->validateLayout($layout, $type->bindings, $geometry);

        if ($problems !== []) {
            return response()->json([
                'message'  => __('The layout did not pass validation.'),
                'problems' => $problems,
            ], HttpResponse::HTTP_UNPROCESSABLE_ENTITY);
        }

        $version->update([
            'project_data' => $layout['project_data'],
            'html'         => $layout['html'],
            'css'          => $layout['css'],
            'geometry'     => $geometry,
            // The reproducibility anchor: the canonical hash of the inputs, not the PDF.
            'hash'  => $this->documents->inputHash($layout['project_data'], $geometry),
            'state' => VersionState::Validated,
        ]);

        return response()->json(['ok' => true]);
    }

    /**
     * POST — render the type's fixture through the production pipeline and stream the
     * PDF. No state change: a preview is a look, not a decision.
     */
    public function preview(Template $template, TemplateVersion $version): HttpResponse
    {
        Gate::authorize('view', $template);

        $type = $template->type();

        $pdf = $this->documents->render(
            ['project_data' => $version->project_data ?? [], 'html' => (string) $version->html, 'css' => (string) $version->css],
            $type->fixture,
            $this->geometry($type, $version->geometry),
            '',
            $type->bindings,
        );

        return response($pdf, HttpResponse::HTTP_OK, [
            'Content-Type'        => 'application/pdf',
            'Content-Disposition' => 'inline; filename="template-'.$template->getKey().'-v'.$version->number.'.pdf"',
        ]);
    }

    /**
     * POST — layer-2 (render) validation, then promote to active.
     *
     * This is the one place the render validation runs: save is the fast static filter,
     * activation is the proof. Only a `validated` version can activate, and the promote
     * and archive happen together so a template never has two active versions or none.
     */
    public function activate(Template $template, TemplateVersion $version): JsonResponse
    {
        Gate::authorize('activate', $template);
        abort_unless($version->state === VersionState::Validated, HttpResponse::HTTP_CONFLICT);

        $type   = $template->type();
        $fields = $type->bindings;
        $geo    = $this->geometry($type, $version->geometry);
        $data   = $type->fixture;
        $layout = ['project_data' => $version->project_data ?? [], 'html' => (string) $version->html, 'css' => (string) $version->css];

        ['pdf' => $pdf, 'seconds' => $seconds] = $this->documents->renderForActivation($layout, $data, $geo, '', $fields);

        $boxes    = $this->documents->codeSlotBoxes($layout, $fields, $geo);
        $problems = $this->documents->validateRender($pdf, $fields, $data, $geo, $seconds, $boxes);

        if ($problems !== []) {
            return response()->json([
                'message'  => __('The rendered document did not pass validation.'),
                'problems' => $problems,
            ], HttpResponse::HTTP_UNPROCESSABLE_ENTITY);
        }

        DB::transaction(function () use ($template, $version) {
            $template->versions()
                ->where('state', VersionState::Active)
                ->whereKeyNot($version->getKey())
                ->update(['state' => VersionState::Archived->value]);

            $version->update([
                'state'        => VersionState::Active,
                'activated_at' => now(),
                'activated_by' => auth()->id() === null ? null : (string) auth()->id(),
            ]);
        });

        return response()->json(['ok' => true]);
    }

    /** GET — the editor's block and field catalogue for a type. */
    public function catalogue(string $type): JsonResponse
    {
        Gate::authorize('viewAny', Template::class);
        abort_unless(array_key_exists($type, (array) config('templates.types')), HttpResponse::HTTP_NOT_FOUND);

        $document = Templates::type($type);

        return response()->json([
            'bindings'          => $document->bindings,
            'nodes'             => $document->nodes,
            'formats'           => config('templates.formats'),
            'code_types'        => config('templates.code_types'),
            'visibility_limits' => $document->pdf['visibility_limits'] ?? [],
            'rule_widths'       => config('templates.rule_widths'),
            'image_max_bytes'   => config('templates.image_max_bytes'),
            'fixture'           => $document->fixture,
            'zones'             => $document->initialLayout['zones'] ?? [],
        ]);
    }

    /**
     * GET — the print stylesheet, served raw. The canvas and the PDF engine have to read
     * exactly the same bytes, so this is deliberately not a bundled asset.
     */
    public function stylesheet(DocumentComposer $composer): HttpResponse
    {
        $css = $composer->printStylesheet();

        return response($css, HttpResponse::HTTP_OK, [
            'Content-Type'  => 'text/css; charset=utf-8',
            'Cache-Control' => 'public, max-age=31536000, immutable',
        ]);
    }

    /**
     * GET — one font file, exactly as declared in `config('templates.fonts')`. The
     * package's default font lives inside vendor/, outside the host's public directory,
     * so the host serves it here; the canvas measures text against the family that
     * actually prints.
     */
    public function font(string $family, int $weight): HttpResponse
    {
        $face = config("templates.fonts.{$family}.weights.{$weight}");
        abort_if($face === null, HttpResponse::HTTP_NOT_FOUND);

        // Absolute paths (the package's own fonts) are used as-is; relative ones are
        // relative to the host's public directory, where the canvas loads them.
        $path = preg_match('/^([a-zA-Z]:[\\\\\/]|\/)/', (string) $face['path']) === 1
            ? $face['path']
            : public_path($face['path']);

        abort_unless(File::exists($path), HttpResponse::HTTP_NOT_FOUND);

        return response(File::get($path), HttpResponse::HTTP_OK, [
            'Content-Type'  => $face['mime'],
            'Cache-Control' => 'public, max-age=31536000, immutable',
        ]);
    }

    /**
     * The geometry the pipeline validates and renders against: the version's own
     * geometry (or the type's `pdf` block as the fallback), with the type's zone bands
     * (`header_height`, `footer_height`) folded in. The toolkit reads those off
     * `geometry['zones']`, so an every_page legal field checked against the header and
     * footer would otherwise be measured against a zero-height band.
     *
     * @param  array<string, mixed>|null  $override  the version's stored geometry, if any
     * @return array<string, mixed>
     */
    private function geometry(\Controlink\Templates\Types\TemplateType $type, ?array $override): array
    {
        $geometry = ($override ?: $type->pdf);
        $geometry['zones'] = $geometry['zones'] ?? ($type->initialLayout['zones'] ?? []);

        return $geometry;
    }
}
