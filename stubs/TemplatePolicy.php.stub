<?php

namespace {{ namespace }}\Policies;

use {{ namespace }}\Models\Template;
use {{ namespace }}\Models\User;

/**
 * Authorization for the template editor.
 *
 * Laravel auto-discovers this policy for the Template model
 * (App\Models\Template -> App\Policies\TemplatePolicy); on Laravel 11+ there is no
 * AuthServiceProvider and no manual registration to do.
 *
 * Generated by `php artisan templates:install`. Every ability denies by default — wire
 * each one to your own roles/permissions before the editor will work.
 */
class TemplatePolicy
{
    /** Guards the `catalogue` endpoint. */
    public function viewAny(User $user): bool
    {
        return false;
    }

    /** Guards `load` and `preview`. */
    public function view(User $user, Template $template): bool
    {
        return false;
    }

    /** Guards `save`. */
    public function update(User $user, Template $template): bool
    {
        return false;
    }

    /**
     * Guards `activate`. Activating binds the host to a layout that every future
     * document points at — a heavier decision than editing, so it is its own ability.
     */
    public function activate(User $user, Template $template): bool
    {
        return false;
    }
}
