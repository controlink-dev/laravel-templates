<?php

namespace {{ namespace }}\Models;

use Controlink\Templates\Models\Concerns\GuardsIssuableVersion;
use Controlink\Templates\Versions\VersionState;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;

/**
 * One snapshot of a template's layout, with its own lifecycle state.
 *
 * Generated by `php artisan templates:install`. `GuardsIssuableVersion` freezes the
 * layout of an active/archived version at the model level, so an issued document can
 * always be reproduced from the exact version that made it.
 */
class TemplateVersion extends Model
{
    use GuardsIssuableVersion;

    protected $fillable = [
        'template_id',
        'number',
        'state',
        'project_data',
        'html',
        'css',
        'hash',
        'geometry',
        'activated_at',
        'activated_by',
    ];

    protected $casts = [
        'state'        => VersionState::class,
        'project_data' => 'array',
        'geometry'     => 'array',
        'activated_at' => 'datetime',
    ];

    /** Whether the layout may still be edited (draft/validated). */
    public function isEditable(): bool
    {
        return $this->state->isEditable();
    }

    public function template(): BelongsTo
    {
        return $this->belongsTo(Template::class);
    }
}
