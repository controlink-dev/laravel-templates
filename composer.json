{
    "name": "controlink/laravel-templates",
    "description": "Versioned templates for Laravel: GrapesJS editor, Twig sandbox rendering, PDF output via Gotenberg",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-intl": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "laravel/framework": "^10.48 || ^11.0 || ^12.0 || ^13.0",
        "twig/twig": "^3.28",
        "bacon/bacon-qr-code": "^3.0",
        "guzzlehttp/guzzle": "^7.0",
        "khanamiryan/qrcode-detector-decoder": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "poppler-utils": "pdftotext/pdftoppm/pdfinfo on PATH for output=pdf activation",
        "gotenberg": "Gotenberg 8 reachable over HTTP for output=pdf"
    },
    "autoload": {
        "psr-4": { "Controlink\\Templates\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Controlink\\Templates\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Controlink\\Templates\\TemplatesServiceProvider"],
            "aliases": { "Templates": "Controlink\\Templates\\Templates" }
        }
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore": ["laravel/framework"]
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
